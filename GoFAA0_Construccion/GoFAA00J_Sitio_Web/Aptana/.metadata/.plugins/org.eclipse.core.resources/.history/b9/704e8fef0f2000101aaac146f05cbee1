@FONTFACE DECLARATIONS FOR THE BRANDING STYLES
=============================================================
*/

/* This are the main layout components. Next we define their textual style  */
body {
    font-family: 'Scketchy1';
    text-align: center;     /* default align config */
}

div#header {
    text-align: left;
}

div#footer {
    text-align: center;
}

/*
The following lines establish the general and specific style of the global site's components. Special attention must be given to the footer and header elements.
*/
.modal {
    text-align: left;
}

#langBox {
    text-align: right;
}

#langTitle {
    color: rgb(190,190,200);
    text-decoration: none;
    text-align: right;
    text-shadow: none;
    font-family: Regular;
    font-weight: normal;
    font-size: 12px;
    font-style: normal;
}

div#helpContent {
    color: rgb(20,25,75);
    text-align: left;
    overflow: auto;
}

.footnote {
    bottom:0px;
    margin: auto auto 0px auto;
    padding: 6px;
	vertical-align: text-bottom;
    text-shadow: rgb(100,100,100) 0px 1px 4px;
    font-size: 10px;
    font-style:normal;
}
#legalInfo {
    text-align: left;
    vertical-align: bottom;
}

#systemConfig {
    text-align: right;
    vertical-align: bottom;
}

.menu_item {
	position: relative;
    width: 800px;
	margin: 10px auto;
	border: 3px solid rgb(240,240,240);
	background: rgb(255,255,255);
	overflow: hidden;

	border-radius: 15px;
    -moz-border-radius: 15px;
}

.menu_item_title {
	width: 100%;
	height: 40px;
	text-align: left;
	padding-left: 20px;
}

.menu_item_dscrptn {
	width: 800px;
	height: 5px;
	text-align: justify;
	/* Set the transition effects for the class */
    transition: all 0.4s linear 0.1s;
    -moz-transition: all 0.4s linear 0.1s; /* Firefox 4 */
    -webkit-transition: all 0.4s linear 0.1s; /* Safari and Chrome */
    -o-transition: all 0.4s linear 0.1s; /* Opera */
}
.menu_item_dscrptn:active {
	width: 800px;
	height: 200px;
	/* Set the transition effects for the class */
    transition: all 0.4s linear 0.1s;
    -moz-transition: all 0.4s linear 0.1s; /* Firefox 4 */
    -webkit-transition: all 0.4s linear 0.1s; /* Safari and Chrome */
    -o-transition: all 0.4s linear 0.1s; /* Opera */
}

unknown {

    /* Add the rotation effect */
    -ms-transform:rotate(4deg); /* IE 9 */
    -moz-transform:rotate(4deg); /* Firefox */
    -webkit-transform:rotate(4deg); /* Safari and Chrome */
    -o-transform:rotate(4deg); /* Opera */
    transform:rotate(4deg);
}

h2 {
	text-transform:			normal;
	white-space:			pre-wrap;
	word-break:				keep-all;
	word-spacing:			normal;
	word-wrap:				break-word;
	text-shadow: 			none;
	font-family: 			Oficial;
}
